    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package - review car data",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {"CANSRC":"archive", "CANDEST":"null", "SHUTDOWN_IN_SECONDS": "180"}
        },
            {
            "name": "Launch Package - create test data",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {"CANSRC":"test", "CANDEST":"archive", "SHUTDOWN_IN_SECONDS": "180"}
        },
            {
            "name": "Launch Package - run in car",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {"CANSRC":"native", "CANDEST":"archive"}
        },
            {
            "name": "Launch Package - run on bench",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {"CANSRC":"test", "CANDEST":"archive"}
        }
    ]

}